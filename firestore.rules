rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════
    //  헬퍼 함수
    // ══════════════════════════════════════════════════════════════

    // 로그인 여부
    function isLoggedIn() {
      return request.auth != null;
    }

    // 현재 사용자의 users 문서 데이터 (lazy evaluation)
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // salonId 일치 여부 — 해당 매장 소속인지 확인
    function belongsToSalon(salonId) {
      return isLoggedIn() && me().salonId == salonId;
    }

    // 역할 체크 (salonId 일치도 동시에 확인)
    function isOwnerOf(salonId) {
      return belongsToSalon(salonId) && me().role == 'owner';
    }

    function isManagerOf(salonId) {
      return belongsToSalon(salonId) && me().role == 'manager';
    }

    function isDesignerOf(salonId) {
      return belongsToSalon(salonId) && me().role == 'designer';
    }

    function isOwnerOrManagerOf(salonId) {
      return isOwnerOf(salonId) || isManagerOf(salonId);
    }

    // 디자이너 본인 확인 — users/{uid}.designerId 와 비교
    function isMyDesigner(salonId, designerId) {
      return isDesignerOf(salonId) && me().designerId == designerId;
    }


    // ══════════════════════════════════════════════════════════════
    //  users/{uid}
    //  - 본인만 읽기/쓰기 가능, 삭제 불가
    // ══════════════════════════════════════════════════════════════

    match /users/{uid} {
      allow read:   if isLoggedIn() && request.auth.uid == uid;
      allow create: if isLoggedIn() && request.auth.uid == uid;
      allow update: if isLoggedIn() && request.auth.uid == uid;
      allow delete: if false;
    }


    // ══════════════════════════════════════════════════════════════
    //  salons/{salonId}  ─ 매장 최상위 문서
    //  - 소속 멤버 읽기, owner만 수정
    // ══════════════════════════════════════════════════════════════

    match /salons/{salonId} {
      allow read:          if belongsToSalon(salonId);
      allow create, update: if isOwnerOf(salonId);
      allow delete:        if false;


      // ── 디자이너 ───────────────────────────────────────────────
      //  소속 멤버 모두 읽기 / owner·manager 추가·수정 / owner만 삭제

      match /designers/{designerId} {
        allow read:          if belongsToSalon(salonId);
        allow create, update: if isOwnerOrManagerOf(salonId);
        allow delete:        if isOwnerOf(salonId);
      }


      // ── 시술 메뉴 ──────────────────────────────────────────────
      //  소속 멤버 모두 읽기 / owner·manager 추가·수정 / owner만 삭제

      match /services/{serviceId} {
        allow read:          if belongsToSalon(salonId);
        allow create, update: if isOwnerOrManagerOf(salonId);
        allow delete:        if isOwnerOf(salonId);
      }


      // ── 고객 기본정보 ──────────────────────────────────────────
      //  소속 멤버 모두 읽기 (designer도 고객명·마스킹 번호 조회 가능)
      //  owner·manager 추가·수정 / owner만 삭제

      match /customers/{customerId} {
        allow read:          if belongsToSalon(salonId);
        allow create, update: if isOwnerOrManagerOf(salonId);
        allow delete:        if isOwnerOf(salonId);

        // 고객 민감정보 서브컬렉션 (private/info)
        // owner·manager만 접근 가능
        match /private/{doc} {
          allow read, write: if isOwnerOrManagerOf(salonId);
        }
      }


      // ── 고객 민감정보 (별도 컬렉션) ────────────────────────────
      //  salons/{salonId}/customerPrivate/{customerId}
      //  owner·manager만 접근 가능

      match /customerPrivate/{customerId} {
        allow read, write: if isOwnerOrManagerOf(salonId);
      }


      // ── 예약 ───────────────────────────────────────────────────
      //  owner·manager: 전체 읽기·생성·수정·삭제
      //  designer: 본인 담당 예약만 읽기·생성·수정 (삭제 불가)

      match /reservations/{reservationId} {
        allow read: if isOwnerOrManagerOf(salonId)
          || (isDesignerOf(salonId) && resource.data.designerId == me().designerId);

        allow create: if isOwnerOrManagerOf(salonId)
          || (isDesignerOf(salonId)
              && request.resource.data.designerId == me().designerId);

        allow update: if isOwnerOrManagerOf(salonId)
          || (isDesignerOf(salonId) && resource.data.designerId == me().designerId);

        allow delete: if isOwnerOf(salonId);
      }


      // ── 메시지 템플릿 ──────────────────────────────────────────
      //  소속 멤버 읽기 / owner·manager 추가·수정 / owner만 삭제

      match /messageTemplates/{templateId} {
        allow read:          if belongsToSalon(salonId);
        allow create, update: if isOwnerOrManagerOf(salonId);
        allow delete:        if isOwnerOf(salonId);
      }


      // ── 메시지 발송 로그 ───────────────────────────────────────
      //  owner·manager만 읽기·생성 / 수정·삭제는 owner만

      match /messageLogs/{messageLogId} {
        allow read:   if isOwnerOrManagerOf(salonId);
        allow create: if isOwnerOrManagerOf(salonId);
        allow update: if isOwnerOf(salonId);
        allow delete: if isOwnerOf(salonId);
      }


      // ── 네이버 연동 설정 ───────────────────────────────────────
      //  소속 멤버 읽기 / owner만 수정

      match /integrationSettings/{settingId} {
        allow read:  if belongsToSalon(salonId);
        allow write: if isOwnerOrManagerOf(salonId);
      }


      // ── 접근 로그 ──────────────────────────────────────────────
      //  소속 멤버 누구나 create / 읽기는 owner·manager / 수정·삭제 불가

      match /accessLogs/{logId} {
        allow read:   if isOwnerOrManagerOf(salonId);
        allow create: if belongsToSalon(salonId);
        allow update: if false;
        allow delete: if false;
      }


      // ── QA 검사 기록 ───────────────────────────────────────────
      //  owner만 read/create 가능 / update·delete 불가
      //  실제 고객·예약 데이터와 분리 유지

      match /qaChecks/{checkId} {
        allow read, create: if isOwnerOf(salonId);
        allow update, delete: if false;
      }
    }
  }
}
